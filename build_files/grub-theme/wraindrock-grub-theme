#!/usr/bin/bash
# wraindrock-grub-theme - opt-in Wraindrock branding for the GRUB boot menu.
#
# The image cannot theme GRUB on its own: on bootc systems /boot/grub2/grub.cfg
# is a static config installed by bootupd and is not regenerated by image
# updates. The supported extension point is /boot/grub2/custom.cfg, which
# bootupd's configs.d/41_custom.cfg sources after the BLS entries are loaded.
#
# This helper copies a small theme next to that file and writes a marked
# custom.cfg. It never edits /boot/grub2/grub.cfg and refuses to overwrite a
# custom.cfg it did not write. The theme lives on /boot, so it also works when
# the root filesystem is encrypted.
#
# Use it after `bootc switch` to Wraindrock Linux:
#
#   sudo wraindrock-grub-theme enable
#   sudo wraindrock-grub-theme status
#   sudo wraindrock-grub-theme disable
set -euo pipefail

PROG=wraindrock-grub-theme
THEME_NAME=wraindrock
SRC_DIR=/usr/share/grub/themes/${THEME_NAME}
FONT_SRC=/usr/share/grub/unicode.pf2
MARKER="# Managed by ${PROG}(8) - run '${PROG} disable' to remove"

ACTION=enable
BOOT_DIR=/boot
ASSUME_YES=0

die() { printf '%s: error: %s\n' "${PROG}" "$*" >&2; exit 1; }
note() { printf '%s: %s\n' "${PROG}" "$*"; }

usage() {
    cat <<EOF
Usage: ${PROG} [enable|disable|status] [--boot-dir DIR] [--yes]

  enable    copy the theme to /boot/grub2/themes/${THEME_NAME} and install a
            marked /boot/grub2/custom.cfg (default action)
  disable   remove the files installed by enable; needs --yes in scripts
  status    report whether the theme is installed

  --boot-dir DIR  operate on DIR instead of /boot (for tests)
  --src-dir DIR   theme source directory (default: ${SRC_DIR})
  --font FILE     GRUB font to install (default: ${FONT_SRC})
  --yes           assume "yes" for disable
  -h, --help      show this help
EOF
}

while (($#)); do
    case "$1" in
        enable|disable|status) ACTION="$1"; shift ;;
        --boot-dir)
            (($# >= 2)) || die "--boot-dir needs a directory"
            BOOT_DIR="$2"
            shift 2
            ;;
        --src-dir)
            (($# >= 2)) || die "--src-dir needs a directory"
            SRC_DIR="$2"
            shift 2
            ;;
        --font)
            (($# >= 2)) || die "--font needs a file"
            FONT_SRC="$2"
            shift 2
            ;;
        --yes|-y) ASSUME_YES=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown argument: $1 (see --help)" ;;
    esac
done

GRUB_DIR=${BOOT_DIR}/grub2
THEME_DIR=${GRUB_DIR}/themes/${THEME_NAME}
CUSTOM_CFG=${GRUB_DIR}/custom.cfg
GRUB_CFG=${GRUB_DIR}/grub.cfg

require_root() {
    if [[ ${EUID} -ne 0 && ${BOOT_DIR} == /boot ]]; then
        die "run as root (or pass --boot-dir for a test fixture)"
    fi
}

require_grub_dir() {
    [[ -d ${GRUB_DIR} ]] \
        || die "${GRUB_DIR} does not exist: this is not a GRUB system (systemd-boot is not supported)"
}

require_custom_hook() {
    [[ -f ${GRUB_CFG} ]] \
        || die "missing ${GRUB_CFG}: this system does not have a GRUB config"
    grep -qF 'custom.cfg' "${GRUB_CFG}" \
        || die "${GRUB_CFG} does not source custom.cfg; run 'sudo bootupctl migrate-static-grub-config' first"
}

is_managed() {
    [[ -f ${CUSTOM_CFG} ]] && grep -qF "${MARKER}" "${CUSTOM_CFG}"
}

install_file() { # <src> <dest> <mode>
    local src=$1 dest=$2 mode=$3
    if [[ -f ${dest} ]] && cmp -s "${src}" "${dest}"; then
        return 0
    fi
    install -D -m "${mode}" "${src}" "${dest}.wraindrock-tmp"
    mv -f "${dest}.wraindrock-tmp" "${dest}"
}

action_enable() {
    require_root
    require_grub_dir
    require_custom_hook

    [[ -f ${SRC_DIR}/theme.txt ]] || die "missing ${SRC_DIR}/theme.txt"
    [[ -f ${SRC_DIR}/background.png ]] || die "missing ${SRC_DIR}/background.png"
    [[ -f ${FONT_SRC} ]] || die "missing ${FONT_SRC}"

    if [[ -e ${CUSTOM_CFG} ]] && ! is_managed; then
        die "refusing to modify ${CUSTOM_CFG}: it exists and was not created by ${PROG}"
    fi

    install -d -m 0755 "${GRUB_DIR}/themes" "${THEME_DIR}"
    install_file "${SRC_DIR}/theme.txt" "${THEME_DIR}/theme.txt" 0644
    install_file "${SRC_DIR}/background.png" "${THEME_DIR}/background.png" 0644
    install_file "${FONT_SRC}" "${THEME_DIR}/unicode.pf2" 0644

    local tmp
    tmp=$(mktemp "${GRUB_DIR}/.custom.cfg.XXXXXX")
    {
        printf '%s\n' "${MARKER}"
        printf 'loadfont ${prefix}/themes/%s/unicode.pf2\n' "${THEME_NAME}"
        printf 'set theme=${prefix}/themes/%s/theme.txt\n' "${THEME_NAME}"
    } > "${tmp}"
    chmod 0644 "${tmp}"
    mv -f "${tmp}" "${CUSTOM_CFG}"

    note "theme installed in ${THEME_DIR}"
    note "wrote ${CUSTOM_CFG}; reboot to see the Wraindrock GRUB menu"
}

action_disable() {
    require_root
    require_grub_dir

    if [[ -e ${CUSTOM_CFG} ]] && ! is_managed; then
        die "refusing to remove ${CUSTOM_CFG}: it was not created by ${PROG}"
    fi

    if [[ ${ASSUME_YES} -ne 1 ]]; then
        if [[ -t 0 ]]; then
            local answer
            read -r -p "Remove the Wraindrock GRUB theme from ${GRUB_DIR}? [y/N] " answer || answer=""
            [[ ${answer} == [yY] ]] || { note "aborted"; exit 0; }
        else
            die "non-interactive disable requires --yes"
        fi
    fi

    [[ ${THEME_DIR} == "${GRUB_DIR}/themes/${THEME_NAME}" ]] \
        || die "refusing to remove an unexpected path: ${THEME_DIR}"
    if [[ -e ${CUSTOM_CFG} ]]; then
        rm -f -- "${CUSTOM_CFG}"
    fi
    if [[ -d ${THEME_DIR} ]]; then
        rm -rf -- "${THEME_DIR}"
    fi
    rmdir -- "${GRUB_DIR}/themes" 2>/dev/null || true
    note "removed the Wraindrock GRUB theme from ${GRUB_DIR}"
}

action_status() {
    if [[ ! -d ${GRUB_DIR} ]]; then
        printf 'grub2 directory: missing (%s)\n' "${GRUB_DIR}"
        return 0
    fi
    if [[ -d ${THEME_DIR} ]]; then
        printf 'theme files: installed (%s)\n' "${THEME_DIR}"
    else
        printf 'theme files: absent\n'
    fi
    if [[ -e ${CUSTOM_CFG} ]]; then
        if is_managed; then
            printf 'custom.cfg: managed by %s\n' "${PROG}"
        else
            printf 'custom.cfg: present, not managed by %s\n' "${PROG}"
        fi
    else
        printf 'custom.cfg: absent\n'
    fi
    if [[ -f ${GRUB_CFG} ]]; then
        if grep -qF 'custom.cfg' "${GRUB_CFG}"; then
            printf 'grub config hook: present\n'
        else
            printf 'grub config hook: missing\n'
        fi
    else
        printf 'grub config: missing (%s)\n' "${GRUB_CFG}"
    fi
}

case ${ACTION} in
    enable) action_enable ;;
    disable) action_disable ;;
    status) action_status ;;
esac
