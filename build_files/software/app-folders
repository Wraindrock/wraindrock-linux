# Wraindrock application folders.
#
# GNOME Shell shows an app in every folder whose apps list or categories
# match it. To keep each icon in exactly one place, this file defines the
# complete folder set (no upstream folder definitions are merged any more):
# every folder lists its apps explicitly, categories are not used, and the
# lists are disjoint. tests/folders.py enforces that invariant.

[org/gnome/desktop/app-folders]
folder-children=['Accessories','Tools','System','Network','Proxies','Social','Office','Virtualization']

[org/gnome/desktop/app-folders/folders/Accessories]
name='附件'
translate=false
apps=['org.gnome.DiskUtility.desktop','org.gnome.Tour.desktop','org.gnome.ColorProfileViewer.desktop']

[org/gnome/desktop/app-folders/folders/Tools]
name='工具'
translate=false
apps=['hplip.desktop','hp-uiscan.desktop','io.github.ronb1964.TuxTalk.desktop','it.mijorus.gearlever.desktop']

[org/gnome/desktop/app-folders/folders/System]
