translate=false
apps=['org.gnome.Settings.desktop','org.gnome.SystemMonitor.desktop','htop.desktop','nvtop.desktop','nvidia-settings.desktop','rygel-preferences.desktop','io.github.kolunmi.Bazaar.desktop','org.freedesktop.MalcontentControl.desktop']

[org/gnome/desktop/app-folders/folders/Network]
