# Wraindrock application folders (dconf).
#
# Bluefin ships seven folders in 01-bluefin-folders and keeps ownership of
# their apps/categories. This file only:
#   * extends folder-children with the Wraindrock folders,
#   * defines those folders with explicit apps lists and no categories,
#   * excludes the apps we re-home from every Bluefin folder.
#
# GNOME puts an app in every folder where it matches
# (apps ∪ categories) − excluded-apps, so moving an app requires excluding it
# from the folder it would otherwise match. An app must live in exactly one
# folder; tests/folders.py enforces that on the merged definition.

[org/gnome/desktop/app-folders]
folder-children=['Games', 'GamingUtilities', 'Accessories', 'Utilities', 'Development', 'Containers', 'Wine', 'Productivity', 'Virtualization', 'Proxies', 'Social', 'Wraindrock', 'uBlue']

# GNOME's own desktop applications live in their own folder. The name points at
# our .directory file because GNOME's X-GNOME-Utilities translation is "工具"
# (Tools), while these are accessories ("附件").
[org/gnome/desktop/app-folders/folders/Accessories]
apps=['org.gnome.Nautilus.desktop', 'org.gnome.Ptyxis.desktop', 'org.gnome.Settings.desktop', 'org.gnome.DiskUtility.desktop', 'org.gnome.SystemMonitor.desktop', 'org.gnome.Tour.desktop', 'org.gnome.tweaks.desktop', 'orca.desktop', 'org.gnome.Calculator.desktop', 'org.gnome.Calendar.desktop', 'org.gnome.Characters.desktop', 'org.gnome.Connections.desktop', 'org.gnome.Contacts.desktop', 'org.gnome.DejaDup.desktop', 'org.gnome.FileRoller.desktop', 'org.gnome.Firmware.desktop', 'org.gnome.Logs.desktop', 'org.gnome.Loupe.desktop', 'org.gnome.Maps.desktop', 'org.gnome.Papers.desktop', 'org.gnome.Showtime.desktop', 'org.gnome.SimpleScan.desktop', 'org.gnome.Snapshot.desktop', 'org.gnome.Decibels.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Weather.desktop', 'org.gnome.baobab.desktop', 'org.gnome.clocks.desktop', 'org.gnome.font-viewer.desktop']
name='wraindrock-accessories.directory'
translate=true

[org/gnome/desktop/app-folders/folders/Virtualization]
apps=['virt-manager.desktop', 'io.podman_desktop.PodmanDesktop.desktop']
name='Virtualization'
translate=false

[org/gnome/desktop/app-folders/folders/Proxies]
apps=['Clash Verge.desktop', 'sing-box.desktop']
name='Proxies'
translate=false

[org/gnome/desktop/app-folders/folders/Social]
apps=['com.tencent.WeChat.desktop', 'com.qq.QQ.desktop', 'com.dingtalk.DingTalk.desktop']
name='wraindrock-social.directory'
translate=true

[org/gnome/desktop/app-folders/folders/Wraindrock]
apps=['helium.desktop', 'Rayburst.desktop']
name='Wraindrock'
translate=false

[org/gnome/desktop/app-folders/folders/uBlue]
apps=['discourse.desktop', 'documentation.desktop', 'system-update.desktop']
name='uBlue'
translate=false

# Bluefin's folders keep their upstream apps and categories. Their exclusion
# lists are repeated here with the re-homed apps appended (and the GNOME apps,
# which match X-GNOME-Utilities), because a later dconf drop-in replaces a key
# rather than extending it.
[org/gnome/desktop/app-folders/folders/GamingUtilities]
excluded-apps=['virt-manager.desktop', 'io.podman_desktop.PodmanDesktop.desktop', 'Clash Verge.desktop', 'sing-box.desktop', 'helium.desktop', 'Rayburst.desktop', 'discourse.desktop', 'documentation.desktop', 'system-update.desktop', 'com.tencent.WeChat.desktop', 'com.qq.QQ.desktop', 'com.dingtalk.DingTalk.desktop']

[org/gnome/desktop/app-folders/folders/Utilities]
