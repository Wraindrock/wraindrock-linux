# Flatpaks installed by flatpak-preinstall.service on first boot.
# Bluefin DX's developer set first, then Wraindrock's personal defaults.
# Flathub must be reachable during that first boot.

[Flatpak Preinstall de.leopoldluley.Clapgrep]
Branch=stable
IsRuntime=false

[Flatpak Preinstall io.github.getnf.embellish]
Branch=stable
IsRuntime=false

[Flatpak Preinstall io.podman_desktop.PodmanDesktop]
Branch=stable
IsRuntime=false

[Flatpak Preinstall me.iepure.devtoolbox]
Branch=stable
IsRuntime=false

[Flatpak Preinstall org.gnome.Builder]
Branch=stable
IsRuntime=false

[Flatpak Preinstall com.github.tuna_os.Tavern]
Branch=stable
IsRuntime=false

# Wraindrock personal preferences. Zen is the default browser; the others are
# ordinary applications the user can remove like any Flatpak.
[Flatpak Preinstall app.zen_browser.zen]
Branch=stable
IsRuntime=false

[Flatpak Preinstall com.tencent.WeChat]
Branch=stable
IsRuntime=false

[Flatpak Preinstall com.github.flxzt.rnote]
Branch=stable
IsRuntime=false

[Flatpak Preinstall it.mijorus.gearlever]
Branch=stable
IsRuntime=false
