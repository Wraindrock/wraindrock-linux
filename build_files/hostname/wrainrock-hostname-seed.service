[Unit]
Description=Seed the Wrainrock hostname on first boot
Documentation=https://github.com/Wraindrock/wrainrock-linux
ConditionPathExists=!/var/lib/wrainrock/hostname-seeded
After=local-fs.target
Before=systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/wrainrock-hostname-seed
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
