# ---------------------------------------------------------------------------
# Wraindrock Linux - image identity and build parameters
# ---------------------------------------------------------------------------
# Single source of truth for "who this image is". Read by the Justfile
# (dotenv), by .github/workflows/build.yml (sourced by bash), passed to the
# Containerfile as build arguments and baked into
# /usr/share/wraindrock/build-info.json.
#
# Every value is quoted because the workflow sources this file as shell.
# tests/lint.sh enforces the quoting and the required keys.
# ---------------------------------------------------------------------------

# Image name - must match the GitHub repository name.
IMAGE_NAME="wraindrock-linux"

# GitHub user or organisation that owns the repository and the image.
REPO_ORGANIZATION="Wraindrock"

IMAGE_DESC="Wraindrock Linux - a Fedora Silverblue based atomic desktop"
IMAGE_KEYWORDS="wraindrock,bootc,fedora,silverblue,atomic,linux,gnome"
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
IMAGE_LICENSE="MIT"

# Fedora release this image tracks. Kept separate from BASE_IMAGE so that a
# rebase is one reviewable two-line change (see docs/roadmap.md).
FEDORA_VERSION="44"

# Base image. Official Fedora Atomic Desktop images are bootc images
# (labels: containers.bootc=1, ostree.bootable=true).
# Alternatives:
#   quay.io/fedora/fedora-kinoite:44    KDE Plasma
#   quay.io/fedora/fedora-bootc:44      minimal Fedora, no desktop
BASE_IMAGE="quay.io/fedora/fedora-silverblue:44"

# Moving channel tag published by CI. `bootc switch ...:44` follows this.
# Immutable build tags are published alongside it and are the artifacts of
# record: <fedora>.<UTC timestamp>.<run number> (see docs/architecture.md).
DEFAULT_TAG="44"
